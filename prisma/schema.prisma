generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["rental"]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("owner") // owner | staff
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@schema("rental")
}

model Car {
  id                String    @id @default(cuid())
  make              String
  model             String
  year              Int?
  registrationPlate String    @unique
  vin               String?
  status            String    @default("available") // available | on_rent | maintenance | retired
  category          String? // e.g. short_wb | long_wb
  /** ICE | BEV — selects which market depreciation curve to use. */
  fuelType          String?
  /** Links to a FINN market model variant for residual-value depreciation. */
  marketModelId     String?
  purchasePriceOre  Int?
  purchaseDate      DateTime?
  purchaseOdometer  Int       @default(0)
  currentOdometer   Int       @default(0)
  location          String?
  insuranceNote     String?
  nextInspectionDue DateTime?
  /** Snapshot rate; when marketModelId is set this is derived (km-only). */
  depPerKmOre       Int       @default(0)
  depPerDayOre      Int       @default(0)
  /** Scheduled service every N km (from last service odometer). */
  serviceIntervalKm Int?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  marketModel        MarketModel?       @relation(fields: [marketModelId], references: [id])
  bookings           Booking[]
  serviceEvents      ServiceEvent[]
  odometerReadings   OdometerReading[]
  fixedCosts         CarFixedCost[]

  @@index([marketModelId])
  @@schema("rental")
}

model CarFixedCost {
  id          String   @id @default(cuid())
  carId       String
  name        String
  amountOre   Int
  /** weekly | monthly | quarterly | half_yearly | annually */
  frequency   String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([carId])
  @@schema("rental")
}

model OdometerReading {
  id         String   @id @default(cuid())
  carId      String
  odometerKm Int
  recordedAt DateTime
  notes      String?
  createdAt  DateTime @default(now())

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([carId, recordedAt])
  @@schema("rental")
}

model Booking {
  id             String   @id @default(cuid())
  carId          String
  customerName   String
  status         String   @default("confirmed") // draft | confirmed | active | completed | cancelled | no_show
  channel        String   @default("private") // getaround | private
  plannedStartAt DateTime // booking start date
  plannedEndAt   DateTime // booking end date
  pickupTime     String? // free-text, optional e.g. "10:00" or "etter lunsj"
  deliveryTime   String? // free-text, optional
  drivenKm       Int?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  car           Car               @relation(fields: [carId], references: [id])
  lineItems     BookingLineItem[]
  serviceEvents ServiceEvent[]

  @@index([carId, plannedStartAt, plannedEndAt])
  @@index([status])
  @@index([plannedStartAt])
  @@schema("rental")
}

model BookingLineItem {
  id          String   @id @default(cuid())
  bookingId   String
  kind        String // revenue | cost
  category    String
  description String
  amountOre   Int // ex VAT, positive
  vatPercent  Float    @default(25)
  quantity    Float    @default(1)
  occurredOn  DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([kind, category])
  @@schema("rental")
}

model ServiceEvent {
  id         String   @id @default(cuid())
  carId      String
  bookingId  String?
  occurredOn DateTime
  odometer   Int?
  type       String // service | tires | brakes | damage | wash | other
  vendor     String?
  amountOre  Int // ex VAT
  vatPercent Float    @default(25)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  car     Car      @relation(fields: [carId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([carId, occurredOn])
  @@index([bookingId])
  @@schema("rental")
}

model LineItemCategory {
  id          String   @id @default(cuid())
  kind        String // revenue | cost
  name        String
  accountCode String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([kind, name])
  @@schema("rental")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@schema("rental")
}

model MarketModel {
  id        String   @id @default(cuid())
  variant   String   @unique
  name      String
  params    Json
  /** Hidden models are excluded from scrape and the market graph. */
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cars Car[]

  @@schema("rental")
}

model MarketListing {
  id           String   @id // finn.no item id
  year         Int?
  km           Int?
  priceNok     Int?
  fuel         String?
  transmission String?
  location     String?
  sellerType   String?
  title        String?
  status       String   @default("active")
  scrapedDate  DateTime @db.Date // first seen
  wltpKm       Int?
  variant      String
  updatedAt    DateTime @updatedAt

  priceHistory MarketPriceObservation[]

  @@index([variant])
  @@index([status])
  @@schema("rental")
}

model MarketPriceObservation {
  id               String   @id @default(cuid())
  listingId        String
  observedDate     DateTime @db.Date
  priceNok         Int?
  previousPriceNok Int?
  deltaNok         Int?
  km               Int?
  status           String?
  variant          String?
  title            String?

  listing MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, observedDate])
  @@schema("rental")
}

model ScrapeJob {
  id         String    @id @default("current")
  status     String    @default("idle") // idle | running | done | error
  message    String    @default("")
  startedAt  DateTime?
  finishedAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@schema("rental")
}
