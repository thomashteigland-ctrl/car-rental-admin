# Copied into Vercel Project Settings → Environment Variables (Production + Preview)
PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Opens from the Market header button (new tab)
PUBLIC_MARKET_APP_URL="http://localhost:3001"

# Required in production. Shared Market viewers must enter this to open Admin.
PUBLIC_ADMIN_ACCESS_CODE="choose-a-secret-code"
